<launch>

  <!-- ========================= -->
  <!-- 可修改参数                -->
  <!-- ========================= -->

  <arg name="can_port" default="can0"/>

  <arg name="map_file"
       default="/home/shuaiawen/ROS1/slam/slam_mapping_ws/navigation_maps/mid360_nav_map.yaml"/>
  
  <!-- true：重定位成功后自动启动 TEB -->
  <arg name="auto_start_teb" default="true"/>


  <!-- ========================= -->
  <!-- 1. Ranger Mini 底盘       -->
  <!-- ========================= -->

  <include file="$(find ranger_bringup)/launch/ranger_mini_v2.launch">

    <arg name="port_name"
         value="$(arg can_port)"/>

    <arg name="robot_model"
         value="ranger_mini_v2"/>

    <arg name="odom_frame"
         value="odom"/>

    <arg name="base_frame"
         value="base_link"/>

    <arg name="odom_topic_name"
         value="odom"/>

    <arg name="publish_odom_tf"
         value="true"/>

  </include>


  <!-- ========================= -->
  <!-- 2. Livox MID360 驱动      -->
  <!-- ========================= -->

  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch"/>


  <!-- ========================= -->
  <!-- 3. FASTLIO2_SAM_LC 重定位 + RViz -->
  <!-- ========================= -->

  <include file="$(find fastlio)/launch/localize.launch"/>


  <!-- ========================= -->
  <!-- 4. nav_map -> map 静态 TF -->
  <!-- ========================= -->

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="nav_map_to_map"
        output="screen"
        args="
          0.539890667
         -0.041005272
          0.033447255
          0.012185016
          0.216920320
         -0.020923988
          0.975888973
          nav_map
          map"/>


  <!-- ========================= -->
  <!-- 5. 二维地图服务器         -->
  <!-- ========================= -->

  <node pkg="map_server"
        type="map_server"
        name="map_server"
        output="screen"
        args="$(arg map_file)">

    <param name="frame_id"
           value="nav_map"/>

  </node>


  <!-- ====================================== -->
  <!-- 6、7. 重定位成功后自动启动桥接和 TEB  -->
  <!-- ====================================== -->

  <node pkg="ranger_navigation"
        type="wait_reloc_then_start.py"
        name="wait_reloc_then_start"
        output="screen">

    <param name="reloc_service"
           value="/slam_reloc_check"/>

    <param name="bridge_package"
           value="ranger_localization_bridge"/>

    <param name="bridge_launch"
           value="nav_map_odom_bridge.launch"/>

    <param name="navigation_package"
           value="ranger_navigation"/>

    <param name="navigation_launch"
           value="move_base_teb.launch"/>

    <param name="settle_time"
           value="3.0"/>

    <param name="auto_start_teb"
           value="$(arg auto_start_teb)"/>

  </node>

  <!-- Ctrl+C 时先取消导航并连续发送零速度 -->
  <node pkg="ranger_navigation"
        type="safe_stop_on_shutdown.py"
        name="safe_stop_on_shutdown"
        output="screen">

    <param name="cmd_vel_topic"
           value="/cmd_vel"/>

    <param name="cancel_topic"
           value="/move_base/cancel"/>

    <param name="publish_rate"
           value="20.0"/>

    <param name="publish_duration"
           value="1.0"/>

  </node>
</launch>
